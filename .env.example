# Copy this file to .env and fill in the keys for whichever demos you want to run.
# .env is gitignored. Bun loads it automatically; the Python CLI loads it via pydantic-settings.
#
# Demo 1 (local pipeline: Pipecat + Moonshine + Kokoro + llama-cpp) — no keys needed.
# Demo 2 (Moshi end-to-end)                                         — no keys needed.

# ─── Demo 3: API comparison (OpenAI Realtime vs. local) ────────────────────────
# Get one at: https://platform.openai.com/api-keys
# Needs Realtime API access on your account.
OPENAI_API_KEY=

# ─── Demo 4: Hume emotion (EVI 3) ──────────────────────────────────────────────
# Get both at: https://platform.hume.ai/settings/keys
# Hume requires API key + secret to mint short-lived tokens at runtime.
HUME_API_KEY=
HUME_SECRET_KEY=

# ─── Optional ──────────────────────────────────────────────────────────────────
# HuggingFace token — avoids download rate limits for Moonshine / Kokoro / Moshi.
# None of those models are gated, so this is just a nice-to-have.
# Get one at: https://huggingface.co/settings/tokens
HF_TOKEN=
